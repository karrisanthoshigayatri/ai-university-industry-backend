# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Similarity / Embedding ─────────────────────────────────────────────────────
# Set to true only if sentence-transformers is installed
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.75
SIMILARITY_TOP_K=5

# ── Qwen2.5 AI Analysis ────────────────────────────────────────────────────────
# Set to true only if Ollama is running with qwen2.5 model
AI_ENABLED=false
QWEN_MODEL=qwen2.5
AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
# Leave blank for Ollama; set for OpenAI-compatible endpoints
AI_API_KEY=
